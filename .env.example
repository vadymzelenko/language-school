# Пароль для входа в /admin (обязателен в продакшене)
ADMIN_PASSWORD=придумайте-длинный-пароль
# Необязательно: отдельный секрет для подписи cookie
ADMIN_SECRET=
# Необязательно: уведомления о новых заявках в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно: где хранить site.json и leads.json (по умолчанию ./content)
CONTENT_DIR=
